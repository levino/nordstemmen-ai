# Qdrant Configuration
QDRANT_URL=https://qdrant.levinkeller.de
QDRANT_COLLECTION=nordstemmen
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_PORT=443 //https://github.com/qdrant/qdrant-js/issues/94#issuecomment-2863549761

# HuggingFace API Key (optional, für bessere Rate Limits)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Jina AI Embeddings API Key
JINA_API_KEY=your_jina_api_key_here

# Backblaze B2 Configuration
B2_KEY_ID=your_b2_application_key_id_here
B2_APP_KEY=your_b2_application_key_here
B2_BUCKET_NAME=your_b2_bucket_name_here
B2_BUCKET_ID=your_b2_bucket_id_here

# PDF Proxy URL (optional, defaults to production)
PDF_PROXY_URL=https://nordstemmen-mcp.levinkeller.de
