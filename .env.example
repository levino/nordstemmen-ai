# Qdrant Configuration
QDRANT_URL=https://qdrant.levinkeller.de
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_PORT=443
QDRANT_COLLECTION=nordstemmen

# Pipeline: Gemini OCR
GOOGLE_API_KEY=your-google-api-key-here

# Pipeline: Jina Embeddings (also used by MCP server for queries)
JINA_API_KEY=your-jina-api-key-here

# Pipeline: Backblaze B2 Storage
B2_KEY_ID=your-b2-key-id-here
B2_APP_KEY=your-b2-app-key-here
B2_BUCKET_ID=your-b2-bucket-id-here
B2_BUCKET_NAME=your-b2-bucket-name-here
