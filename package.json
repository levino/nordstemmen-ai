{
  "name": "nordstemmen-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "scraper",
    "mcp-server",
    "pipeline"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces",
    "lfs-pull": "git lfs pull --include='*'",
    "lfs:repair": "bash scripts/lfs-repair.sh",
    "pipeline": "npm run pipeline --workspace=pipeline --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6"
  }
}
